{% extends 'base.html.twig' %}

{% block title %}Editar Detalle #{{ detalle.id }}{% endblock %}

{% block body %}
<div class="card shadow-sm p-4">
    <h2 class="text-primary mb-4">Editar Detalle del Siniestro</h2>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-6">
                {{ form_row(form.id_persona) }}
                {{ form_row(form.rol) }}
                {{ form_row(form.tipo_vehiculo) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.estadoAlcoholico) }}
                {{ form_row(form.porcentajeAlcohol) }}
                {{ form_row(form.observaciones) }}
            </div>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary">Guardar</button>
            <a href="{{ path('detalle_show', {id: detalle.id}) }}" class="btn btn-secondary">Cancelar</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
